# FURNITURA Luxury Furniture - MTN MoMo Sandbox & Backend Configuration

# Server Port
PORT=5001

# MTN MoMo Sandbox Environment Configuration
MTN_ENV=sandbox
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_TARGET_ENVIRONMENT=sandbox

# MTN MoMo Collection Credentials (Obtain from https://momodeveloper.mtn.com)
MTN_COLLECTION_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=

# MTN Callback / Webhook URL (Publicly accessible URL, e.g. via ngrok or production host)
MTN_CALLBACK_URL=https://your-public-domain.com/api/payments/mtn/callback

# Configurable Payment Transport Currency (EUR or RWF according to your Sandbox User Currency)
MTN_CURRENCY=EUR

# Storefront Display Currency
STORE_CURRENCY=USD
