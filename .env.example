# ==============================================================================
# FURNITURA LUXURY COMMERCE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER BACKEND / NODE ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=10000
CORS_ORIGINS=https://furnitura.pages.dev,https://admin-furnitura.pages.dev

# ------------------------------------------------------------------------------
# 2. MONGODB ATLAS PRODUCTION DATABASE
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster-url>/furnitura_prod?retryWrites=true&w=majority
MONGODB_URI=

# ------------------------------------------------------------------------------
# 3. FIREBASE AUTHENTICATION (SERVER-SIDE ADMIN SDK)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Ensure multi-line private key is properly formatted with \n if single-line
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. MTN MOMO API (SANDBOX / PRODUCTION)
# ------------------------------------------------------------------------------
MTN_ENV=sandbox
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_COLLECTION_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENVIRONMENT=sandbox
MTN_CURRENCY=EUR
MTN_CALLBACK_URL=https://api.furnitura.rw/api/payments/mtn/callback

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE PAGES FRONTEND (VITE CLIENT VARIABLES)
# ------------------------------------------------------------------------------
# Set in Cloudflare Pages Project Settings -> Environment Variables
VITE_API_URL=https://api.furnitura.rw

# Firebase Client SDK Public Config (Safe for browser use)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
